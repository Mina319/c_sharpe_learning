<Window x:Class="HelloWorld_WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelloWorld_WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="textBoxShowHello" HorizontalAlignment="Center" Margin="0,21,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="780" Height="23"/>
        <Button x:Name="buttonSayHello" Content="Click me" HorizontalAlignment="Center" Margin="0,68,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.767,-2.879" Height="27" Width="780" Click="Button_Click"/>

    </Grid>
</Window>
